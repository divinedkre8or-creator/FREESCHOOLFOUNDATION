# Public Supabase project settings. These values are intentionally exposed to the browser;
# database Row Level Security remains the authorization boundary.
VITE_SUPABASE_URL=https://amzcvuknjtpsrktkdhcf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-project-publishable-key

# Server runtime aliases. Use the same project as the public values.
SUPABASE_URL=https://amzcvuknjtpsrktkdhcf.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-project-publishable-key

# Server-only. Never prefix this with VITE_ and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-secure-server-environment

# CLI-only database password used to link/push migrations. Never expose to browser code.
SUPABASE_DB_PASSWORD=replace-with-project-database-password

APP_BASE_URL=https://thefreeschoolfoundation.com.ng
LOG_LEVEL=info

# Direct Resend API delivery for post-confirmation platform emails. These are
# server-only and must be configured in the hosting provider's secret store.
RESEND_API_KEY=replace-with-private-resend-api-key
RESEND_FROM_EMAIL="The Free School Foundation <notifications@updates.thefreeschoolfoundation.com.ng>"
RESEND_REPLY_TO=officialnwachukwudivine@gmail.com

# Supabase Edge Function secret only. Never expose with a VITE_ prefix.
CLOUDMERSIVE_API_KEY=replace-with-private-virus-scan-key
